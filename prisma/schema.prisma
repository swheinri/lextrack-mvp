// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthTokenType {
  INVITE
  RESET
  ACTIVATE
}

enum PersonStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum LocationType {
  HQ
  OFFICE
  WAREHOUSE
  MAINTENANCE_BASE
  TRAINING_CENTER
  BRANCH
  OTHER
}

enum OrgFunction {
  MEMBER
  LEAD
  DEPUTY
}

enum RegisterDocumentStatus {
  CAPTURED
  ASSIGNED
  IN_REVIEW
  REJECTED
  ACTIVE
  OBSOLETE
  ARCHIVED
}

enum AssignmentStatus {
  ASSIGNED
  IN_REVIEW
  COMPLETED
}

enum AssessmentRelevance {
  UNASSESSED
  RELEVANT
  NOT_RELEVANT
  ACTION_REQUIRED
}

enum MatrixStatus {
  DRAFT
  IN_REVIEW
  FINAL
}

enum ComplianceClauseStatus {
  OPEN
  COMPLIANT
  NOT_FULFILLED
  NOT_APPLICABLE
}

enum LocationAccessLevel {
  READ
  CONTRIBUTE
  RESPONSIBLE
  ADMIN
}

enum RiskAggregationMode {
  WORST_CASE
  INDEX
}

enum RiskScope {
  ALL
  NON_COMPLIANT
}

enum PsoeLevel {
  P
  S
  O
  E
}

model Location {
  id          String       @id @default(cuid())
  name        String
  kuerzel     String?      @db.VarChar(32)
  type        LocationType @default(OFFICE)
  description String?
  isActive    Boolean      @default(true)

  leadPersonId String?
  leadPerson   Person? @relation("LocationLead", fields: [leadPersonId], references: [id], onDelete: SetNull)

  organisationName   String?
  organisationalUnit String?
  contactName        String?
  contactPhone       String?
  contactMobile      String?
  contactEmail       String?

  departments Department[]
  addresses   LocationAddress[]

  documentLocationAssignments DocumentLocationAssignment[]
  userLocationAccesses        UserLocationAccess[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@unique([kuerzel])
  @@index([name])
  @@index([type])
}

model LocationAddress {
  id String @id @default(cuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  label       String?
  street      String?
  houseNumber String?
  postalCode  String?
  city        String?
  state       String?
  country     String?

  building       String?
  floor          String?
  room           String?
  area           String?
  additionalInfo String?

  latitude  Float?
  longitude Float?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([city])
  @@index([country])
}

model Department {
  id          String  @id @default(cuid())
  name        String
  kuerzel     String? @db.VarChar(32)
  description String?
  isActive    Boolean @default(true)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  people Person[]
  teams  Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadPersonId String?
  leadPerson   Person? @relation("DepartmentLead", fields: [leadPersonId], references: [id], onDelete: SetNull)

  @@unique([locationId, name])
  @@index([leadPersonId])
  @@index([locationId])
}

model Team {
  id          String  @id @default(cuid())
  name        String
  kuerzel     String? @db.VarChar(32)
  description String?
  isActive    Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  people Person[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Person {
  id        String       @id @default(cuid())
  firstName String
  lastName  String?
  email     String       @unique
  status    PersonStatus @default(INVITED)

  // Legacy-/Fallback-Zuordnung:
  // Bleibt vorerst bestehen, damit bestehende Funktionen nicht brechen.
  // Langfristig soll die organisatorische Zuordnung primär über teamId laufen.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Neue primäre Organisationszuordnung:
  // Person → Team → Abteilung → Standort
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Fachliche Rolle im Directory-Kontext.
  // Die Login-Rolle liegt weiterhin zusätzlich am User-Modell.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Verknüpfung zum echten Login-User nach Einladung / Registrierung.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  invitedAt     DateTime?
  acceptedAt    DateTime?
  lastInvitedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledDepartments Department[] @relation("DepartmentLead")
  ledLocations   Location[]   @relation("LocationLead")

  orgFunction OrgFunction @default(MEMBER)

  @@index([teamId, orgFunction])
  @@index([departmentId, orgFunction])
  @@index([departmentId])
  @@index([teamId])
  @@index([roleId])
  @@index([status])
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false)

  users   User[]
  persons Person[] // optional: Directory-Person kann Rolle bekommen

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String?
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  tokens AuthToken[]
  person Person? // Back-Relation (FK liegt in Person.userId)

  assignedDocumentLocationAssignments DocumentLocationAssignment[] @relation("DocumentLocationAssignedBy")
  assessedLocationAssessments         LocationAssessment[]         @relation("LocationAssessmentAssessedBy")
  locationAccesses                    UserLocationAccess[]
  createdAt                           DateTime                     @default(now())
  updatedAt                           DateTime                     @updatedAt
}

model AuthToken {
  token     String        @id
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, type])
}

model RegisterDocument {
  id String @id @default(cuid())

  dokumentenart  String?
  vertragsumfeld String?
  rechtsart      String?
  normFamily     String?

  kuerzel     String
  bezeichnung String
  themenfeld  String?

  publiziert DateTime?
  frist      DateTime?
  relevanz   String?

  status RegisterDocumentStatus @default(CAPTURED)

  herausgeber String?
  gueltigSeit DateTime?
  gueltigBis  DateTime?

  dokumentUrl      String?
  quelleUrl        String?
  dokumentFileName String?
  dokumentFileHref String?
  dokumentName     String?

  zustaendigkeit String?
  kategorie      String?
  abgeloestDurch String?

  erfasserVorname   String?
  erfasserNachname  String?
  erfasserAbteilung String?

  obsoletedAt    DateTime?
  archivedAt     DateTime?
  retentionUntil DateTime?

  assignments DocumentLocationAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([kuerzel])
  @@index([themenfeld])
  @@index([relevanz])
  @@index([frist])
}

model DocumentLocationAssignment {
  id String @id @default(cuid())

  documentId String
  document   RegisterDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  status  AssignmentStatus @default(ASSIGNED)
  dueDate DateTime?

  assignedByUserId String?
  assignedByUser   User?   @relation("DocumentLocationAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  assessment LocationAssessment?
  matrix     ComplianceMatrix?

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([documentId, locationId])
  @@index([documentId])
  @@index([locationId, status])
  @@index([assignedByUserId])
  @@index([dueDate])
}

model LocationAssessment {
  id String @id @default(cuid())

  assignmentId String                     @unique
  assignment   DocumentLocationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  relevance AssessmentRelevance @default(UNASSESSED)

  riskMode          String?
  bewertungErgebnis String?
  evaluationNote    String?

  evaluationLikelihood Int?
  evaluationImpact     Int?
  evaluationScore      Int?
  evaluationLevel      String?
  evaluatedAt          DateTime?
  evaluatedBy          String?

  mitigationPlanned Boolean   @default(false)
  mitigationAt      DateTime?

  projektJson Json?

  comment        String?
  actionRequired Boolean @default(false)
  actionSummary  String?

  assessedByUserId String?
  assessedByUser   User?   @relation("LocationAssessmentAssessedBy", fields: [assessedByUserId], references: [id], onDelete: SetNull)

  assessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([relevance])
  @@index([actionRequired])
  @@index([assessedByUserId])
  @@index([evaluatedAt])
}

model ComplianceMatrix {
  id String @id @default(cuid())

  assignmentId String                     @unique
  assignment   DocumentLocationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  status MatrixStatus @default(DRAFT)

  riskAggregationMode RiskAggregationMode @default(WORST_CASE)
  riskScope           RiskScope           @default(NON_COMPLIANT)

  clauses ComplianceMatrixClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ComplianceMatrixClause {
  id String @id @default(cuid())

  matrixId String
  matrix   ComplianceMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  refLevel1 String?
  refLevel2 String?
  refLevel3 String?

  titleLevel1 String?
  titleLevel2 String?
  titleLevel3 String?

  requirementText String?
  evidenceNote    String?
  comment         String?

  status ComplianceClauseStatus @default(OPEN)

  psoeLevel       PsoeLevel?
  riskSeverity    Int?
  riskProbability Int?

  parentId String?
  parent   ComplianceMatrixClause?  @relation("ComplianceMatrixClauseTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ComplianceMatrixClause[] @relation("ComplianceMatrixClauseTree")

  internalRefsJson Json?
  legalRefsJson    Json?
  processRefsJson  Json?
  formRefsJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matrixId])
  @@index([parentId])
  @@index([status])
}

model UserLocationAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  accessLevel LocationAccessLevel @default(READ)
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, locationId])
  @@index([userId, accessLevel])
  @@index([locationId, accessLevel])
  @@index([isActive])
}
